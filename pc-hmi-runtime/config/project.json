{
  "name": "Plant HMI",
  "subtitle": "Processing System",
  "startupScreen": "100_Overview",
  "communication": {
    "driver": "simulator",
    "opcua": {
      "endpoint": "opc.tcp://localhost:4840",
      "securityMode": "None",
      "securityPolicy": "None"
    },
    "pollIntervalMs": 200,
    "reconnectIntervalMs": 5000
  },
  "users": [
    { "username": "operator", "password": "operator", "role": "operator", "level": 1 },
    { "username": "engineer", "password": "engineer", "role": "engineer", "level": 5 },
    { "username": "admin", "password": "admin", "role": "admin", "level": 10 }
  ],
  "tags": [
    { "name": "System.AutoMode", "type": "bool", "description": "1=Auto, 0=Manual" },
    { "name": "System.Healthy", "type": "bool", "description": "1=Healthy, 0=Fault" },
    { "name": "System.Running", "type": "bool", "description": "Line running status" },
    { "name": "Production.Count", "type": "int", "description": "Total production count" },
    { "name": "Production.Rate", "type": "float", "description": "Units per hour" },
    { "name": "Production.Efficiency", "type": "float", "description": "OEE percentage" },
    { "name": "Recipe.Active", "type": "string", "description": "Current recipe name" },
    { "name": "Recipe.Number", "type": "int", "description": "Active recipe number" }
  ],
  "alarms": [
    { "tag": "Alarm.EStop", "message": "Emergency stop activated", "priority": 1 },
    { "tag": "Alarm.DoorOpen", "message": "Safety door open", "priority": 2 },
    { "tag": "Alarm.LowAir", "message": "Low air pressure", "priority": 3 },
    { "tag": "Alarm.MotorFault", "message": "Motor M01 fault", "priority": 2 },
    { "tag": "Alarm.HighTemp", "message": "High temperature detected", "priority": 3 }
  ]
}
