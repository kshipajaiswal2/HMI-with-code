{
  "id": "200_Settings",
  "title": "Settings",
  "navGroup": "settings",
  "securityLevel": 1,
  "components": [
    {
      "type": "SectionHeader",
      "label": "Machine Settings"
    },
    {
      "type": "Grid",
      "style": {
        "className": "metric-grid cols-3"
      },
      "children": [
        {
          "type": "NumericDisplay",
          "tag": "Settings.SpeedSetpoint",
          "label": "Speed Setpoint",
          "format": "float",
          "decimals": 1,
          "unit": "%"
        },
        {
          "type": "NumericDisplay",
          "tag": "Settings.TempSetpoint",
          "label": "Temperature Setpoint",
          "format": "float",
          "decimals": 1,
          "unit": "°C"
        },
        {
          "type": "StateIndicator",
          "tag": "Settings.AutoStart",
          "label": "Auto Start",
          "states": {
            "true": {
              "text": "Enabled",
              "color": "#00c000"
            },
            "false": {
              "text": "Disabled",
              "color": "#888"
            }
          }
        }
      ]
    },
    {
      "type": "Panel",
      "style": {
        "className": "control-row"
      },
      "children": [
        {
          "type": "ToggleButton",
          "tag": "Settings.AutoStart",
          "label": "Toggle Auto Start"
        },
        {
          "type": "MomentaryButton",
          "tag": "System.Running",
          "label": "Start Line",
          "value": true
        },
        {
          "type": "MomentaryButton",
          "tag": "System.Running",
          "label": "Stop Line",
          "value": false
        }
      ]
    }
  ],
  "displaySettings": {
    "backgroundColor": "#EBEBEB",
    "useProjectSize": true
  },
  "template": {
    "enabled": true,
    "globalObjectId": "Template",
    "replace": {
      "NavSettings": {
        "caption": "Settings",
        "image": "select_settings.jpg",
        "imageScaled": false,
        "italic": false,
        "underline": false,
        "foreColor": "#000000",
        "useForeColor": true,
        "captionBackStyle": "transparent",
        "useCaptionBackColor": false,
        "captionBackColor": "#002952",
        "captionBlink": false,
        "audio": true,
        "shape": "rectangle",
        "patternStyle": "none",
        "useVariableDisplay": false,
        "parameterType": "file",
        "parameterFile": "",
        "parameterList": "",
        "displayPosition": false,
        "displayTop": 0,
        "displayLeft": 0,
        "useVariableDisplayPosition": false,
        "horizontalMargin": 0,
        "verticalMargin": 0
      }
    }
  }
}
